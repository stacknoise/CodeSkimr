{
  "name": "codeskimr-web",
  "private": true,
  "version": "0.1.0",
  "description": "The browser UI of CodeSkimr (blueprint 15, ADR 0028).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --config eslint.literals.config.js src",
    "format": "prettier --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^3.2.7"
  }
}
